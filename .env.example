# Local development only. Set a unique password in .env; never commit it.
POSTGRES_DB=bigbang
POSTGRES_USER=bigbang
POSTGRES_PASSWORD=replace-with-a-strong-local-password
APP_PORT=8080
WEB_PORT=8088

# Supply both only for first startup, then remove them. Never commit .env.
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_TIMEOUT=30m
# Set true when using HTTPS. Production must use HTTPS and secure cookies.
SESSION_COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW=15m

# Comma-separated exact browser origins; configure HTTPS origins for production.
WS_ALLOWED_ORIGINS=http://localhost:8088
WS_HEARTBEAT_MS=10000
WS_MESSAGE_SIZE_BYTES=65536
WS_SEND_BUFFER_BYTES=262144
WS_SEND_TIMEOUT_MS=10000
